/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022" ,
    "ignoreDeprecations": "5.0",
    "baseUrl": "./", 
    "paths": {
      "@maps/*": ["src/app/core/maps/*"],
      "@app/*": ["src/app/*"],
      "@env/*" : ["src/environments/*"] ,
      "@baseclass/*" : ["src/app/core/classes/*"],
      "@core/*" : ["src/app/core/*"],
      "@utils/*" : ["src/app/core/utils/*"],
      "@interfaces/*" : ["src/app/core/interfaces/*"],
      "@services/*" : ["src/app/core/services/*"],
      "@documentos/*" : ["src/app/workspace/operatividad/documentos/*"],
      "@operations/*" : ["src/app/workspace/OPERATIONS/*"],
      "@configSys/*" : ["src/app/workspace/CONFIG_SYSTEM/*"],
      "@system-shared/*" : ["src/app/metasystem/components/*"],
      "@system-pipe/*" : ["src/app/metasystem/pipe/*"],
      "@location/*": ["src/app/workspace/database/location/*"],
      "@logistica/*": ["src/app/workspace/database/logistica/*"],
      "@organization/*": ["src/app/workspace/database/organization/*"],
      "@rh/*": ["src/app/workspace/database/rh/*"],
      "@system/*": ["src/app/workspace/system/*"],
      "@security/*": ["src/app/workspace/system/security/*"],
      "@settings/*": ["src/app/workspace/system/settings/*"],
      "@dashboard/*": ["src/app/workspace/portal/dashboard/*"],
      "@user-settings/*": ["src/app/workspace/portal/userSettings/*"],
      "@gateway/*": ["src/app/gateway/*"],
      "@metasystem/*": ["src/app/metasystem/*"],
      "@workspace-shared/*": ["src/app/workspace/shared/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
